# === PayCue data (local-first — no RapidAPI required at runtime) ===

# Local CardData API for dev (optional; production uses SQLite in-process)
CREDITREWARDS_DATA_API_URL=http://127.0.0.1:8080
CREDITREWARDS_USE_LOCAL_API=true

# Optional one-off upstream sync (sync-reference, backfill-catalog-reference)
# Leave off for normal dev/production — data lives in data/reference/ + SQLite.
CREDITREWARDS_USE_UPSTREAM_API=
REWARDS_CC_API_KEY=
# REWARDS_CC_API_KEY=
# REWARDS_CC_BASE_URL=https://rewards-credit-card-api.p.rapidapi.com

# Bulk sync quota guard (only if USE_UPSTREAM_API=1)
# REWARDS_CC_BULK_MAX_CALLS=48000

# === Merchant lookup ===
GOOGLE_MAPS_API_KEY=
CREDITREWARDS_GOOGLE_PLACES=1

# === Trial analytics ===
CREDITREWARDS_ANALYTICS_ENABLED=1
CREDITREWARDS_ANALYTICS_ADMIN_PASSWORD=
