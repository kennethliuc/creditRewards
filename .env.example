# === Rewards CC upstream API (for sync-reference golden data) ===
# Copy this file to .env and fill in values. Never commit .env or paste keys in chat.

# How did you sign up?
#   rapidapi  — BASIC/PRO/ULTRA via RapidAPI (most common)
#   direct    — MEGA/SUPREME via info@rewardscc.com (contact us if different base URL)
REWARDS_CC_AUTH_MODE=rapidapi

# RapidAPI: App → Rewards Credit Card API → Header "X-RapidAPI-Key"
REWARDS_CC_API_KEY=

# RapidAPI default (usually no change needed)
REWARDS_CC_BASE_URL=https://rewards-credit-card-api.p.rapidapi.com

# Subscription key for GET /creditcard-apiusage/{skey}
# Find in Rewards CC dashboard or signup confirmation email
REWARDS_CC_SKEY=

# Bulk sync quota guard (ULTRA ~50k/month; leave headroom)
REWARDS_CC_BULK_MAX_CALLS=48000

# === Our local CardData API ===
CREDITREWARDS_DATA_API_URL=http://127.0.0.1:8080
CREDITREWARDS_USE_LOCAL_API=true
CREDITREWARDS_DB_PATH=
CREDITREWARDS_API_MONTHLY_LIMIT=2500
CREDITREWARDS_DEFAULT_SKEY=dev

# === AwardWallet Credit Card Bonus API (optional third-party valuation + merchant bonuses) ===
# Request credentials: https://awardwallet.com/api/cc
AWARDWALLET_CC_API_USER=
AWARDWALLET_CC_API_PASSWORD=
AWARDWALLET_CC_BASE_URL=https://us-cc-api.awardwallet.com/v1
